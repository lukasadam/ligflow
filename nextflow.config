/*
 * ligflow – Nextflow pipeline configuration
 * ==========================================
 *
 * Profiles
 * --------
 *   conda       – Use conda environments defined in envs/ (default).
 *   test        – Run the built-in synthetic test dataset (no input required).
 *   docker      – Placeholder for future Docker/Singularity support.
 *
 * Usage
 * -----
 *   nextflow run main.nf -profile conda --input data.h5ad --ligand CXCL12 \
 *       --prior nichenet_prior.csv --grn nichenet_grn.csv
 */

// ── Global defaults ───────────────────────────────────────────────────────────

nextflow.enable.dsl = 2

params {
    // Input / output
    input            = null
    outdir           = 'results'

    // Prior networks
    prior            = null   // path to ligand-target CSV/TSV
    grn              = null   // path to GRN CSV/TSV
    build_priors     = false  // set true to build NicheNet priors via R

    // Ligand(s) – comma-separated when multiple
    ligand           = null

    // Embedding parameters
    n_pcs            = 30
    n_neighbors      = 30
    normalize        = true
    target_sum       = 10000
    embedding_key    = 'X_umap'

    // Ligand-flow parameters
    n_iter           = 3
    damping          = 0.8
    expression_layer = null

    // Plotting
    n_genes          = 20
    color            = null   // obs column for velocity plot colouring

    // Misc
    help             = false
}

// ── Include base resource config ─────────────────────────────────────────────

includeConfig 'conf/base.config'

// ── Profiles ──────────────────────────────────────────────────────────────────

profiles {
    conda {
        conda.enabled  = true
        conda.useMamba = false
        // Ensure bin/ scripts are on the PATH in every process
        process.beforeScript = "export PATH='${projectDir}/bin:\$PATH'"
    }

    mamba {
        conda.enabled  = true
        conda.useMamba = true
        process.beforeScript = "export PATH='${projectDir}/bin:\$PATH'"
    }

    test {
        params {
            input        = null        // synthetic data generated in the pipeline
            ligand       = 'Gene0'
            prior        = null        // generated synthetically
            grn          = null        // generated synthetically
            outdir       = 'test_results'
            n_pcs        = 10
            n_neighbors  = 10
        }
    }

    docker {
        docker.enabled = true
        // Images to be defined once Docker support is added
    }
}

// ── Manifest ──────────────────────────────────────────────────────────────────

manifest {
    name            = 'ligflow'
    author          = 'ligflow contributors'
    homePage        = 'https://github.com/lukasadam/ligflow'
    description     = 'Ligand-induced cell-state transition simulation for single-cell data'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

// ── Reports & tracing ─────────────────────────────────────────────────────────

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
